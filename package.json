{
  "name": "theater-mode",
  "version": "2.1.3",
  "description": "检测到页面有视频播放时显示悬浮按钮，一键进入影院模式，支持快进/回退、快捷键及自定义设置。",
  "scripts": {
    "build:zip": "mkdir -p dist && zip -r dist/theater-mode-v$npm_package_version.zip . -x '*.git*' -x '*.DS_Store' -x '*.zip' -x 'dist/*' -x 'node_modules/*'"
  },
  "keywords": [
    "chrome-extension",
    "theater-mode",
    "video-player"
  ],
  "author": "",
  "license": "MIT"
}
